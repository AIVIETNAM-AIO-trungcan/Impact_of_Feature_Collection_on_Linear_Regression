# Ignore virtual environment
.venv/

# Ignore Python cache
__pycache__/
*.py[cod]

# Ignore data files
data/raw/*.csv
data/processed/*.csv
*.xlsx
*.parquet

# Ignore LaTeX build temporary files
reports/*.aux
reports/*.log
reports/*.out
reports/*.toc
reports/*.fls
reports/*.fdb_latexmk
reports/*.synctex.gz

# Ignore model output files and artifacts
*.pkl
reports/baseline_report.json